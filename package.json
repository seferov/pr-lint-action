{
  "name": "pr-lint-action",
  "version": "2.0.0",
  "description": "PR Lint for GitHub Actions",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist",
    "verify-index": "npm run build && git diff --exit-code dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seferov/pr-lint-action.git"
  },
  "keywords": [
    "actions",
    "pr",
    "lint"
  ],
  "author": "Farhad Safarov",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/seferov/pr-lint-action/issues"
  },
  "homepage": "https://github.com/seferov/pr-lint-action#readme",
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@types/node": "^20.0.0",
    "prettier": "^2.1.2",
    "typescript": "^5.0.0",
    "@vercel/ncc": "^0.38.0"
  }
}
